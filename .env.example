# PostgreSQL
POSTGRES_PASSWORD=change-me-in-production

# Go API
JWT_SECRET=change-me-in-production

# Google OAuth (optional; leave empty to disable Google login). The redirect URL is
# compared byte for byte against the one in the Cloud console, and it has to be the *app*
# host — see docs/deploy.md 3. Local development keeps the localhost default below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Front end origin: used for the post-login redirect and for the cookie Secure flag.
# Must be https in production.
FRONTEND_URL=http://localhost:5173

# Mail: log prints codes to the container log, smtp relays them (docs/deploy.md 4)
MAIL_DRIVER=log

# Dev-only mock login
MOCK_AUTH_EMAIL=dev@ohyourear.test
MOCK_AUTH_NAME=Developer
