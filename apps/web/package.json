{
  "name": "@oh-your-ear/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint . -D correctness -D suspicious -D perf --allow react/react-in-jsx-scope --allow no-unassigned-import --allow no-named-as-default-member",
    "check:i18n": "node ../../scripts/check-i18n.mjs .",
    "generate": "openapi-typescript ../../openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@oh-your-ear/shared": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.46.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.7.0",
    "tonal": "6.4.3",
    "tone": "15.1.22",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.83.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0"
  },
  "license": "Apache-2.0"
}
